# Port the server listens on
PORT=3000
# Folder for the SQLite file and uploaded images
DATA_DIR=./data
# Max size of one uploaded photo in megabytes
MAX_UPLOAD_MB=10
# Max photos per upload request
MAX_FILES_PER_UPLOAD=10
# Max login/register attempts per IP per 10 minutes (0 turns the limit off)
AUTH_RATE_LIMIT=30
# Set to "true" when served over HTTPS so the session cookie is Secure
COOKIE_SECURE=false
