# Port the server listens on
PORT=3000
# MongoDB connection string. Free option: a MongoDB Atlas free cluster.
# Keep the real value only in .env (ignored by git), never commit it.
MONGODB_URI=mongodb://127.0.0.1:27017
# Alternative to MONGODB_URI for hosts with a secrets dashboard (Atlas SRV host):
# MONGODB_HOST=cluster0.abcde.mongodb.net
# MONGODB_USER=photoalbums_app
# MONGODB_PASSWORD=
# Database name inside that MongoDB
MONGODB_DB=photoalbums
# Max size of one uploaded photo in megabytes
MAX_UPLOAD_MB=10
# Max photos per upload request
MAX_FILES_PER_UPLOAD=10
# Max total stored image size in megabytes (keeps the app under a 512 MB free database)
MAX_TOTAL_STORAGE_MB=350
# Max login/register attempts per IP per 10 minutes (0 turns the limit off)
AUTH_RATE_LIMIT=30
# Set to "true" when served over HTTPS so the session cookie is Secure
COOKIE_SECURE=false
# Set to "true" behind a reverse proxy (Render, etc.) so the client IP is read correctly
TRUST_PROXY=false
# Set to "true" to create the demo user and photos on start when they do not exist yet
SEED_DEMO=false
